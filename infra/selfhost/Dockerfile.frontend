# Static assets and Nginx configuration must come from the same frozen fork revision.
ARG RUNTIME_IMAGE=nginx:1.27.5-alpine@sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
FROM ${RUNTIME_IMAGE}

ARG RUNTIME_IMAGE
ARG RUNTIME_IMAGE_ID=sha256:65645c7bb6a0661892a8b03b89d0743208a18dd2f3f17a54ef4b76fb8e2f2a10
ARG SOURCE_REPOSITORY=https://github.com/he1016060110/GEORank
ARG SOURCE_REVISION
ARG RUNTIME_DEPENDENCIES_SHA256

RUN test -n "$SOURCE_REPOSITORY" \
    && test "${#SOURCE_REVISION}" -eq 40 \
    && case "$SOURCE_REVISION" in *[!0-9a-f]*) exit 1 ;; esac \
    && test "${#RUNTIME_DEPENDENCIES_SHA256}" -eq 64 \
    && case "$RUNTIME_DEPENDENCIES_SHA256" in *[!0-9a-f]*) exit 1 ;; esac

LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.georank.build.runtime-image="${RUNTIME_IMAGE}" \
      io.georank.build.runtime-image-id="${RUNTIME_IMAGE_ID}" \
      org.yysensor.georank.runtime-dependencies.sha256="${RUNTIME_DEPENDENCIES_SHA256}" \
      io.georank.build.runtime-mode="pinned-nginx-with-source-replacement" \
      io.georank.build.source-policy="frozen-git-archive-required"

# Never retain the default Nginx page or an old application configuration.
RUN rm -rf /usr/share/nginx/html /etc/nginx/conf.d \
    && mkdir -p /usr/share/nginx/html /etc/nginx/conf.d
COPY dist/ /usr/share/nginx/html/
COPY infra/nginx/default.conf /etc/nginx/conf.d/default.conf
# Frontend's dependency contract is its frozen Nginx proxy configuration.
RUN test "$(sha256sum /etc/nginx/conf.d/default.conf | cut -d ' ' -f 1)" = "$RUNTIME_DEPENDENCIES_SHA256"

EXPOSE 80
CMD ["nginx", "-g", "daemon off;"]
