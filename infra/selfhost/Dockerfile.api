# Root-context build. This image reuses cached dependencies, not cached application code.
ARG RUNTIME_IMAGE=georank-deps-api:20261006-0e304874320f
FROM ${RUNTIME_IMAGE}

ARG RUNTIME_IMAGE
ARG RUNTIME_IMAGE_ID=sha256:0e304874320ff6093df1e71015a99e443793b66259b998c04de317701c7647cd
ARG SOURCE_REPOSITORY=https://github.com/he1016060110/GEORank
ARG SOURCE_REVISION
ARG RUNTIME_DEPENDENCIES_SHA256

RUN test -n "$SOURCE_REPOSITORY" \
    && test "${#SOURCE_REVISION}" -eq 40 \
    && case "$SOURCE_REVISION" in *[!0-9a-f]*) exit 1 ;; esac \
    && test "${#RUNTIME_DEPENDENCIES_SHA256}" -eq 64 \
    && case "$RUNTIME_DEPENDENCIES_SHA256" in *[!0-9a-f]*) exit 1 ;; esac

LABEL org.opencontainers.image.source="${SOURCE_REPOSITORY}" \
      org.opencontainers.image.revision="${SOURCE_REVISION}" \
      io.georank.build.runtime-image="${RUNTIME_IMAGE}" \
      io.georank.build.runtime-image-id="${RUNTIME_IMAGE_ID}" \
      org.yysensor.georank.runtime-dependencies.sha256="${RUNTIME_DEPENDENCIES_SHA256}" \
      io.georank.build.runtime-mode="cached-dependencies-with-source-replacement" \
      io.georank.build.source-policy="frozen-git-archive-required" \
      io.georank.build.entrypoint-normalization="crlf-to-lf"

WORKDIR /app

# Dependencies live outside /app. Remove ALL inherited application files first;
# COPY over an old tree alone would leave deleted modules from the parent image.
RUN python -c "from pathlib import Path; import shutil, site; root = Path('/app'); assert all(not Path(p).resolve().is_relative_to(root) for p in site.getsitepackages()), 'Cannot replace an application-local dependency runtime'; [shutil.rmtree(p) if p.is_dir() and not p.is_symlink() else p.unlink() for p in root.iterdir()]; (root / 'runtime').mkdir()"
COPY backend/ /app/
# This is the frozen SOURCE dependency-contract hash, not an installation claim.
RUN python -c "from pathlib import Path; import hashlib, sys; assert hashlib.sha256(Path('/app/requirements.txt').read_bytes()).hexdigest() == sys.argv[1], 'Source requirements digest differs from release manifest'" "$RUNTIME_DEPENDENCIES_SHA256"
COPY --chmod=0755 backend/docker-entrypoint.sh /usr/local/bin/georank-entrypoint

# Windows checkouts can contain CRLF. This declared normalization is the only
# transformation of the fork's entrypoint; no entrypoint is taken from the parent.
RUN python -c "from pathlib import Path; paths = (Path('/app/docker-entrypoint.sh'), Path('/usr/local/bin/georank-entrypoint')); [(p.write_bytes(p.read_bytes().replace(b'\r\n', b'\n')), p.chmod(0o755)) for p in paths]" \
    && python -m compileall -q /app/app

EXPOSE 8000
ENTRYPOINT ["/usr/local/bin/georank-entrypoint"]
CMD ["uvicorn", "app.main:app", "--host", "0.0.0.0", "--port", "8000"]
